PORT=5000

# Only set this to 1 if the backend is running behind a real reverse proxy
# or load balancer (e.g. nginx, an AWS/GCP LB, Cloudflare). It tells Express
# to trust the X-Forwarded-For header for the client's real IP — every
# IP-based security control (rate limiting, the IP blocklist, brute-force
# logging in utils/security.js) depends on this being right. Leave unset
# for the current docker-compose setup (port 5000 published directly) —
# trusting X-Forwarded-For with no proxy actually in front of you lets a
# client spoof their own IP and walk straight through those controls.
TRUST_PROXY=

# MongoDB Atlas (or local) connection string. Never commit the real value.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?appName=<appName>

# Any long random string — e.g. generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Razorpay dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

CLIENT_URL=http://localhost:5173

# Admin bootstrap — two ways to create your first admin:
# 1) Set these and run `npm run seed:admin` once (recommended, CLI-only)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password
ADMIN_NAME=Admin Name
ADMIN_PHONE=+10000000000
ADMIN_ADDRESS=

# 2) OR set this and use the "I have an admin invite code" option on the
#    site's register page — anyone with this code can self-register as admin,
#    so remove/rotate it once your admins are set up
ADMIN_INVITE_CODE=replace_with_a_random_invite_code

# Service (cold-outreach panel) team invite code — same idea as
# ADMIN_INVITE_CODE, but for the "I have a service invite code" option on
# the register page. Grants access to /dashboard/service (AI-drafted cold
# email/WhatsApp outreach). Rotate/remove once your service team is set up.
SERVICE_INVITE_CODE=replace_with_a_random_invite_code

# Phone OTP verification for registration (Twilio) — leave blank to use the
# dev fallback, which logs the code to the console and returns it in the
# /api/auth/send-otp response body instead of sending a real SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# "Continue with Google" sign-up/sign-in — must match VITE_GOOGLE_CLIENT_ID
# in frontend/.env (same OAuth Client ID, used as the token audience here).
# Leave blank to disable Google auth; /api/auth/google-* routes will 503.
GOOGLE_CLIENT_ID=

# Givi AI chatbot (Google Gemini API — free tier, no credit card required)
#   1. Go to aistudio.google.com -> sign in with a Google account.
#   2. Click "Get API key" (left sidebar) -> "Create API key" -> pick or
#      create a Google Cloud project when prompted -> copy the key.
#   3. Paste it below. Free tier limits (per Google, subject to change):
#      ~15 requests/minute, ~1M tokens/day — plenty for a site chatbot.
#      Leave blank to disable Givi; it'll respond with a "not configured"
#      message instead of crashing.
#   NOTE: use "gemini-flash-lite-latest", not a pinned dated version and
#   not plain "gemini-flash-latest". Pinned versions (e.g. gemini-2.0-flash)
#   came back with a hard 0 free-tier quota on this account even though the
#   key works fine otherwise. "gemini-flash-latest" DID work, but currently
#   resolves to a brand-new preview model with only 20 requests/DAY on the
#   free tier — burns out almost immediately. The "-lite-latest" alias
#   resolves to the lite line, which Google grants a much larger free daily
#   quota since it's designed for higher-volume free/cheap usage.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Email notifications (optional - leave blank to skip sending emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=GivsiaTech <no-reply@givsiatech.com>
ADMIN_NOTIFY_EMAIL=

# AI Lead Finder (Admin Dashboard -> Business Discovery) — Google Places API
# key, used ONLY to discover public business listings (name/address/phone/
# rating/review-count/website-presence) via Google's official, ToS-compliant
# API. It does NOT return owner name or email — Google doesn't expose those.
#   1. console.cloud.google.com -> select/create a project.
#   2. Enable "Places API" (legacy) under APIs & Services -> Library.
#   3. APIs & Services -> Credentials -> Create API key. Restrict it to the
#      Places API for safety.
# Leave blank to disable live discovery — the "Discover via Google Places"
# button will show a "not configured" message; manual entry and CSV import
# still work without this key.
GOOGLE_PLACES_API_KEY=
